# Copy this file to .env and edit the values
PORT=5000
NODE_ENV=development

# Browser client origin for CORS. Set to the deployed frontend URL in production if hosted separately.
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/redfox

# Secret used to sign admin login cookies. REQUIRED in production (32+ random characters).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin login cookie is sent only over HTTPS in production. Set to false ONLY if you run production on plain http.
# COOKIE_SECURE=true

# Folder for uploaded images (default: server/uploads)
# UPLOADS_DIR=

# Optional: email each new quote request. Leave SMTP_HOST empty to skip.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="REDFOX Website <no-reply@redfoxonline.in>"
MAIL_TO=info@redfoxonline.in
